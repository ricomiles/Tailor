# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tailor: irreplaceable local state — canon, SQLite, logs, rendered PDFs
/data
/out

# Per-machine configuration: the list of boards this checkout watches. The
# startup bootstrap creates it only when it is absent, and a human edits it
# afterwards. Tracked, one developer's board list would arrive in everyone
# else's checkout and every local edit would show up as a diff.
/boards.json

# Temporary probe written by scripts/verify-boundaries.mjs; cleaned up on exit.
__boundary-probe.*

# BMad tooling: skill definitions and the rendered workflow engine.
# Reinstallable, and noisy in diffs. The design record in _bmad-output/
# (architecture, epics, specs, sprint status) stays tracked deliberately.
/.claude/
/_bmad/
/BMAD-PLAN.md

# Playwright: browser-run artifacts, regenerated on every `pnpm test:e2e`.
/test-results
/playwright-report
/blob-report

# The Playwright freshness marker (scripts/e2e-gate.mjs) — a hash of the
# sources the e2e suite observes, rewritten on every passing run.
/.e2e-verified
